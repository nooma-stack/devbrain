<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.devbrain.closure-scanner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>DEVBRAIN_CLOSURE_REMOTE_OK=${DEVBRAIN_CLOSURE_REMOTE_OK:-} ~/devbrain/ingest/launchd/run-closure-scan.sh</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>/tmp/devbrain-closure-scanner.log</string>
  <key>StandardErrorPath</key><string>/tmp/devbrain-closure-scanner.log</string>
</dict>
</plist>
