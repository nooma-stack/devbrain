<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- cognify_edges: every-6h cites + contradicts edge inference over EVERY  -->
<!-- active project (no project argument). Up to 15 judge calls per run,     -->
<!-- shared round-robin across projects; codex first, Anthropic fallback.    -->
<!-- Placeholders ${DEVBRAIN_HOME}, ${USER} and the credential-env marker    -->
<!-- are substituted by `devbrain setup-cognify-launchd`. Do NOT cp this     -->
<!-- file directly into ~/Library/LaunchAgents/ — placeholders won't expand. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.devbrain.cognify-edges</string>

    <key>ProgramArguments</key>
    <array>
        <string>${DEVBRAIN_HOME}/.venv/bin/python</string>
        <string>${DEVBRAIN_HOME}/factory/cli.py</string>
        <string>cognify</string>
        <string>--pass=edges</string>
    </array>

    <!-- Run every 6 hours -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DEVBRAIN_HOME</key>
        <string>${DEVBRAIN_HOME}</string>
        <key>PYTHONPATH</key>
        <string>${DEVBRAIN_HOME}/factory</string>
        <!-- launchd's default PATH omits Homebrew, so the codex CLI (a   -->
        <!-- `#!/usr/bin/env node` script) fails with "env: node: No such -->
        <!-- file or directory" under launchd.                            -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- @CREDENTIAL_ENV_BLOCK@ — installer emits ANTHROPIC_API_KEY or  -->
        <!-- CLAUDE_CODE_OAUTH_TOKEN here based on env at install time.    -->
    </dict>

    <key>WorkingDirectory</key>
    <string>${DEVBRAIN_HOME}/factory</string>

    <key>StandardOutPath</key>
    <string>/Users/${USER}/.devbrain/logs/cognify-edges.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/${USER}/.devbrain/logs/cognify-edges.err</string>

    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
