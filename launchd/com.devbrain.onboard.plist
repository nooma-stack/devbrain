<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<!--
  DevBrain Onboarding Webhook — launchd agent.

  Runs the host-native webhook receiver under launchd so it stays up
  across reboots and respawns on crash. Logs to
  ~/Library/Logs/devbrain-onboard.log (rotate via macOS' built-in log
  rotation if it grows).

  Install:
    cp ~/devbrain/launchd/com.devbrain.onboard.plist \
       ~/Library/LaunchAgents/com.devbrain.onboard.plist
    launchctl load ~/Library/LaunchAgents/com.devbrain.onboard.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.devbrain.onboard</string>

  <key>ProgramArguments</key>
  <array>
    <!-- macOS 26 (Tahoe) added a "Local Network" TCC permission that
         silently denies listening-socket binds for faceless launchd
         processes (no UI to display the consent prompt). Workaround:
         tunnel through `login -fpq` so the process inherits the GUI
         user session's existing TCC grant. Without this, http.server
         binds but the socket immediately goes to CLOSED state. See
         docs/plans/onboarding-webhook-deploy.md for the full diagnosis. -->
    <string>/usr/bin/login</string>
    <string>-fpq</string>
    <string>lhtdev</string>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec /Users/lhtdev/devbrain/bin/devbrain-onboard</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Minimum uptime gate to avoid respawn-storms on a permanent error
       (e.g., DB unreachable). 10s of crashing without a 60s success
       window will trip launchd's throttle. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/lhtdev/Library/Logs/devbrain-onboard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lhtdev/Library/Logs/devbrain-onboard.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/lhtdev/devbrain</string>

  <!-- SessionCreate puts the agent in the user's Aqua GUI session
       context. Without this, on Python 3.14 + macOS, http.server's
       listening socket goes into CLOSED state immediately after bind
       (verified empirically 2026-05-01). With SessionCreate=true the
       socket binds and listens correctly. -->
  <key>SessionCreate</key>
  <true/>
</dict>
</plist>
